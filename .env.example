#######################################################################
# MOSCOW — environment
# Copy to .env.local and fill in. Everything here is OPTIONAL for local
# development: with no file at all, the site boots on a local JSON
# database and seeds itself.
#######################################################################

# ---------------------------------------------------------------------
# Session signing — REQUIRED IN PRODUCTION
# The app refuses to start in production without it.
#   openssl rand -base64 48
# ---------------------------------------------------------------------
AUTH_SECRET=

# ---------------------------------------------------------------------
# First-boot admin account (local JSON database only).
# CHANGE THE PASSWORD BEFORE GOING LIVE.
# ---------------------------------------------------------------------
ADMIN_EMAIL=admin@moscow.store
ADMIN_PASSWORD=MoscowAdmin!2026

# ---------------------------------------------------------------------
# Canonical URL — used for metadata, OG tags, sitemap and robots.txt
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://moscow.store

# ---------------------------------------------------------------------
# Supabase — leave blank to keep using the local JSON database.
# The moment NEXT_PUBLIC_SUPABASE_URL *and* SUPABASE_SERVICE_ROLE_KEY are
# both present, every read and write switches to Supabase on restart.
# Run supabase/schema.sql in the SQL editor first.
#
# SUPABASE_SERVICE_ROLE_KEY IS SERVER-ONLY.
# It has no NEXT_PUBLIC_ prefix, so Next.js will never bundle it into
# client JavaScript. Never add that prefix to it.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=mosco-media
